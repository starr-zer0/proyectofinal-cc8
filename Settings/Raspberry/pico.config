CONFIG_NSH_NETINIT=y
CONFIG_NSH_WGET_BUFF_SIZE=512

#
# Telnet Configuration
#
# CONFIG_NSH_LOGIN is not set
# CONFIG_NSH_CONSOLE_LOGIN is not set

#
# Platform-specific Support
#
# CONFIG_PLATFORM_CONFIGDATA is not set

#
# Software Define Radio Libraries
#
# CONFIG_SDR_LIQUID_DSP is not set

#
# System Libraries and NSH Add-Ons
#
# CONFIG_SYSTEM_ARGTABLE3 is not set
# CONFIG_SYSTEM_BATTERYDUMP is not set
# CONFIG_SYSTEM_CLE is not set
# CONFIG_SYSTEM_CPULOAD is not set
# CONFIG_SYSTEM_CUTERM is not set
CONFIG_SYSTEM_DD=y
CONFIG_SYSTEM_DD_PROGNAME="dd"
CONFIG_SYSTEM_DD_PRIORITY=100
CONFIG_SYSTEM_DD_STACKSIZE=2048
CONFIG_SYSTEM_DD_STATS=y
CONFIG_SYSTEM_DHCPC_RENEW=y
CONFIG_DHCPC_RENEW_PROGNAME="renew"
CONFIG_DHCPC_RENEW_PRIORITY=100
CONFIG_DHCPC_RENEW_STACKSIZE=2048
# CONFIG_SYSTEM_FASTBOOTD is not set
# CONFIG_SYSTEM_FDT is not set
# CONFIG_SYSTEM_FLATBUFFERS is not set
# CONFIG_SYSTEM_HEX2BIN is not set
# CONFIG_SYSTEM_HEXED is not set
# CONFIG_SYSTEM_HOSTNAME is not set
# CONFIG_SYSTEM_MDIO is not set
CONFIG_SYSTEM_NETDB=y
CONFIG_SYSTEM_NETDB_STACKSIZE=2048
CONFIG_SYSTEM_NETDB_PRIORITY=100
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_NSH_PRIORITY=100
CONFIG_SYSTEM_NSH_STACKSIZE=2048
CONFIG_SYSTEM_NSH_PROGNAME="nsh"
CONFIG_SYSTEM_NTPC=y
CONFIG_SYSTEM_NTPC_PRIORITY=100
CONFIG_SYSTEM_NTPC_STACKSIZE=2048
# CONFIG_SYSTEM_NXCODEC is not set
# CONFIG_SYSTEM_NXDIAG is not set
# CONFIG_SYSTEM_OFLOADER is not set
# CONFIG_SYSTEM_PING6 is not set
CONFIG_SYSTEM_PING=y
CONFIG_SYSTEM_PING_PROGNAME="ping"
CONFIG_SYSTEM_PING_PRIORITY=100
CONFIG_SYSTEM_PING_STACKSIZE=2048

#
# psmq requires LOGGING_EMBEDLOG and !DISABLE_MQUEUE
#
# CONFIG_SYSTEM_PTPD is not set
CONFIG_SYSTEM_READLINE=y
CONFIG_READLINE_HAVE_EXTMATCH=y
CONFIG_READLINE_ECHO=y
# CONFIG_READLINE_TABCOMPLETION is not set
CONFIG_READLINE_CMD_HISTORY=y
CONFIG_READLINE_CMD_HISTORY_LINELEN=80
CONFIG_READLINE_CMD_HISTORY_LEN=16
# CONFIG_SYSTEM_RESMONITOR is not set
# CONFIG_SYSTEM_SETLOGMASK is not set
# CONFIG_SYSTEM_SETTINGS is not set
CONFIG_SYSTEM_SPITOOL=y
CONFIG_SPITOOL_PROGNAME="spi"
CONFIG_SPITOOL_PRIORITY=100
CONFIG_SPITOOL_STACKSIZE=2048
CONFIG_SPITOOL_MINBUS=0
CONFIG_SPITOOL_MAXBUS=3
CONFIG_SPITOOL_DEFFREQ=4000000
CONFIG_SPITOOL_DEFMODE=0
CONFIG_SPITOOL_DEFWIDTH=8
CONFIG_SPITOOL_DEFWORDS=1
CONFIG_SYSTEM_SYSTEM=y
CONFIG_SYSTEM_SYSTEM_STACKSIZE=2048
CONFIG_SYSTEM_SYSTEM_PRIORITY=100
# CONFIG_SYSTEM_SYSTEM_DUMPINFO is not set
# CONFIG_SYSTEM_TCPDUMP is not set
# CONFIG_SYSTEM_TEE is not set
# CONFIG_SYSTEM_TELNET_CHATD is not set
CONFIG_SYSTEM_TELNET_CLIENT=y
CONFIG_SYSTEM_TELNET_CLIENT_PROGNAME="telnet"
CONFIG_SYSTEM_TELNET_CLIENT_STACKSIZE=2048
CONFIG_SYSTEM_TELNET_CLIENT_PRIORITY=100
# CONFIG_SYSTEM_TERMCURSES is not set
# CONFIG_SYSTEM_UBLOXMODEM is not set
# CONFIG_SYSTEM_VI is not set
# CONFIG_SYSTEM_YMODEM is not set
# CONFIG_LIB_ZLIB is not set
# CONFIG_SYSTEM_ZMODEM is not set

#
# TEE Libraries Support
#
# CONFIG_LIBTEEC is not set

